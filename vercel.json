{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" }
  ],
  "headers": [
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "X-Frame-Options", "value": "SAMEORIGIN" }] },
    { "source": "/checkout", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
